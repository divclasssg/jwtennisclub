{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://jwtennisclub.invalid/schemas/task8/evidence-event-v1.schema.json",
    "title": "Task 8 load evidence event",
    "oneOf": [
        { "$ref": "#/$defs/request" },
        { "$ref": "#/$defs/lockWait" },
        { "$ref": "#/$defs/telemetryCapability" },
        { "$ref": "#/$defs/counter" },
        { "$ref": "#/$defs/resource" },
        { "$ref": "#/$defs/recovery" },
        { "$ref": "#/$defs/runWindow" }
    ],
    "$defs": {
        "base": {
            "type": "object",
            "required": ["schemaVersion", "kind", "timestamp"],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "type": "string" },
                "timestamp": { "$ref": "#/$defs/timestamp" }
            }
        },
        "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "phase",
                "sessionId",
                "requestType",
                "iteration",
                "durationMs",
                "status",
                "outcome"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "request" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "phase": { "enum": ["baseline", "after"] },
                "sessionId": { "type": "string", "minLength": 1 },
                "requestType": {
                    "enum": [
                        "operator_poll",
                        "member_read",
                        "member_command",
                        "web"
                    ]
                },
                "iteration": { "type": "integer", "minimum": 0 },
                "operationId": { "type": "string", "minLength": 1 },
                "durationMs": { "type": "number", "minimum": 0 },
                "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                "outcome": { "enum": ["ok", "timeout", "failure"] }
            }
        },
        "lockWait": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "operationId",
                "lockWaitMs",
                "source",
                "instrumentationPoint",
                "resolutionMs"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "lock_wait" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "operationId": { "type": "string", "minLength": 1 },
                "lockWaitMs": { "type": "number", "minimum": 0 },
                "source": { "const": "instrumented_lock_acquisition" },
                "instrumentationPoint": {
                    "const": "member_command_lock_acquisition"
                },
                "resolutionMs": { "type": "number", "exclusiveMinimum": 0 }
            }
        },
        "telemetryCapability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "source",
                "instrumentationPoint",
                "collectorVersion",
                "resolutionMs",
                "coverageStartedAt",
                "coverageEndedAt",
                "approvalId"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "telemetry_capability" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "source": { "const": "instrumented_lock_acquisition" },
                "instrumentationPoint": {
                    "const": "member_command_lock_acquisition"
                },
                "collectorVersion": { "type": "string", "minLength": 1 },
                "resolutionMs": { "type": "number", "exclusiveMinimum": 0 },
                "coverageStartedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "coverageEndedAt": { "type": "string", "format": "date-time" },
                "approvalId": { "type": "string", "minLength": 1 }
            }
        },
        "counter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "phase",
                "name",
                "value"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "counter" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "phase": { "enum": ["before", "after"] },
                "name": {
                    "enum": [
                        "deadlocks",
                        "timeouts",
                        "server5xx",
                        "webTransactionFailures"
                    ]
                },
                "value": { "type": "number", "minimum": 0 }
            }
        },
        "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "phase",
                "name",
                "warningUsageRatio"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "resource" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "phase": { "enum": ["before", "after"] },
                "name": { "enum": ["cpu", "connections"] },
                "warningUsageRatio": { "type": "number", "minimum": 0 }
            }
        },
        "recovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "restoreStartedAt",
                "restoreHealthyAt",
                "recoveryPointAt",
                "latestRestoredOperationAt",
                "beforeMemberChecksum",
                "afterMemberChecksum",
                "beforeMatchChecksum",
                "afterMatchChecksum"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "recovery" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "restoreStartedAt": { "type": "string", "format": "date-time" },
                "restoreHealthyAt": { "type": "string", "format": "date-time" },
                "recoveryPointAt": { "type": "string", "format": "date-time" },
                "latestRestoredOperationAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "beforeMemberChecksum": { "$ref": "#/$defs/sha256" },
                "afterMemberChecksum": { "$ref": "#/$defs/sha256" },
                "beforeMatchChecksum": { "$ref": "#/$defs/sha256" },
                "afterMatchChecksum": { "$ref": "#/$defs/sha256" }
            }
        },
        "runWindow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "kind",
                "timestamp",
                "startedAt",
                "endedAt"
            ],
            "properties": {
                "schemaVersion": { "const": 1 },
                "kind": { "const": "run_window" },
                "timestamp": { "$ref": "#/$defs/timestamp" },
                "startedAt": { "$ref": "#/$defs/timestamp" },
                "endedAt": { "$ref": "#/$defs/timestamp" }
            }
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    }
}
