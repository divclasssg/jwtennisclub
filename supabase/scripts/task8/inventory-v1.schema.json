{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://jwtennisclub.invalid/schemas/task8/inventory-v1.schema.json",
    "title": "Task 8 rollout custody inventory",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "identity",
        "migrations",
        "memberBaseline",
        "auth",
        "tables",
        "storage",
        "databaseFunctions",
        "edgeFunctions",
        "backup",
        "recovery"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "validationRef",
                "productionSystemIdentifier",
                "validationSystemIdentifier",
                "databaseOid",
                "markerDigest",
                "provenanceId"
            ],
            "properties": {
                "validationRef": {
                    "type": "string",
                    "pattern": "^[a-z]{20}$"
                },
                "productionSystemIdentifier": {
                    "type": "string",
                    "pattern": "^[0-9]{10,32}$"
                },
                "validationSystemIdentifier": {
                    "type": "string",
                    "pattern": "^[0-9]{10,32}$"
                },
                "databaseOid": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "markerDigest": { "$ref": "#/$defs/sha256" },
                "provenanceId": { "type": "string", "minLength": 1 }
            }
        },
        "migrations": {
            "type": "array",
            "items": { "$ref": "#/$defs/migration" }
        },
        "memberBaseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "sha256"],
            "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "userCount",
                "identityCount",
                "providerCounts",
                "instanceId",
                "siteUrl",
                "redirectHosts",
                "jwtExpirySeconds"
            ],
            "properties": {
                "userCount": { "type": "integer", "minimum": 0 },
                "identityCount": { "type": "integer", "minimum": 0 },
                "providerCounts": {
                    "type": "object",
                    "additionalProperties": { "type": "integer", "minimum": 0 }
                },
                "instanceId": { "type": "string", "minLength": 1 },
                "siteUrl": { "type": "string", "format": "uri" },
                "redirectHosts": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "jwtExpirySeconds": { "type": "integer", "minimum": 1 }
            }
        },
        "tables": { "type": "array", "items": { "$ref": "#/$defs/namedHash" } },
        "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectRef", "buckets"],
            "properties": {
                "projectRef": {
                    "type": "string",
                    "pattern": "^[a-z]{20}$"
                },
                "buckets": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/bucket" }
                }
            }
        },
        "databaseFunctions": {
            "type": "array",
            "items": { "$ref": "#/$defs/function" }
        },
        "edgeFunctions": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/edgeFunction" }
        },
        "backup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "physicalBackupsEnabled",
                "pitrEnabled",
                "newestRecoveryPointAt"
            ],
            "properties": {
                "physicalBackupsEnabled": { "type": "boolean" },
                "pitrEnabled": { "type": "boolean" },
                "newestRecoveryPointAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "recovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "restoreStartedAt",
                "restoreHealthyAt",
                "recoveryPointAt",
                "latestRestoredOperationAt",
                "beforeMemberChecksum",
                "afterMemberChecksum",
                "beforeMatchChecksum",
                "afterMatchChecksum"
            ],
            "properties": {
                "restoreStartedAt": { "type": "string", "format": "date-time" },
                "restoreHealthyAt": { "type": "string", "format": "date-time" },
                "recoveryPointAt": { "type": "string", "format": "date-time" },
                "latestRestoredOperationAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "beforeMemberChecksum": { "$ref": "#/$defs/sha256" },
                "afterMemberChecksum": { "$ref": "#/$defs/sha256" },
                "beforeMatchChecksum": { "$ref": "#/$defs/sha256" },
                "afterMatchChecksum": { "$ref": "#/$defs/sha256" }
            }
        }
    },
    "$defs": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "migration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "name", "sha256"],
            "properties": {
                "version": {
                    "type": "string",
                    "pattern": "^[0-9]{12,14}$"
                },
                "name": { "type": "string" },
                "sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "namedHash": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "name", "rowCount", "sha256"],
            "properties": {
                "schema": { "type": "string" },
                "name": { "type": "string" },
                "rowCount": { "type": "integer", "minimum": 0 },
                "sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "bucket": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "public",
                "fileSizeLimit",
                "allowedMimeTypes",
                "objectCount"
            ],
            "properties": {
                "id": { "type": "string" },
                "public": { "type": "boolean" },
                "fileSizeLimit": { "type": ["integer", "null"] },
                "allowedMimeTypes": {
                    "type": ["array", "null"],
                    "items": { "type": "string" }
                },
                "objectCount": { "type": "integer", "minimum": 0 }
            }
        },
        "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "name", "identityArguments", "sha256"],
            "properties": {
                "schema": { "type": "string" },
                "name": { "type": "string" },
                "identityArguments": { "type": "string" },
                "sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "edgeFunction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "status"],
            "properties": {
                "name": {
                    "enum": [
                        "admin-command",
                        "game-day-command",
                        "game-day-snapshot",
                        "match-recommendation",
                        "member-link",
                        "member-read",
                        "operator-read"
                    ]
                },
                "version": { "type": "integer", "minimum": 1 },
                "status": { "const": "ACTIVE" }
            }
        }
    }
}
